# Normalize all text files to LF (matches devcontainer + Godot expectations)
* text=auto eol=lf

# Godot / project text files (explicit for clarity)
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.py text eol=lf
*.cfg text eol=lf

# Binary assets — never normalize
*.wav binary
*.png binary
*.jpg binary
*.glb binary
*.gltf binary
*.zip binary
