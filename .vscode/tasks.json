      "problemMatcher": [] },
    { "label": "Test: scripted bot races",
      "type": "shell",
      "command": "godot --headless --path chicane3d scenes/tests/TestRace.tscn",
      "problemMatcher": [] },
    { "label": "Benchmark: world gen + frame cost",
      "type": "shell",
      "command": "godot --headless --path chicane3d scenes/tests/Bench.tscn",
      "problemMatcher": [] },
    { "label": "Run game (xvfb, container — for smoke tests only)",
      "type": "shell",
      "command": "xvfb-run -a -s '-screen 0 1280x720x24' godot --path chicane3d --rendering-driver opengl3",
      "problemMatcher": [] },
    { "label": "Screenshot suite (xvfb)",
      "type": "shell",
      "command": "xvfb-run -a -s '-screen 0 1280x720x24' godot --path chicane3d --rendering-driver opengl3 scenes/tests/TestShot.tscn",
